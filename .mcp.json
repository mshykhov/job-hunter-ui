{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--no-install",
        "chrome-devtools-mcp",
        "--isolated",
        "--headless",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--no-install",
        "playwright-mcp",
        "--isolated",
        "--headless"
      ]
    }
  }
}
